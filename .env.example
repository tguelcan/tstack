# Postgres connection for Prisma and the SvelteKit server.
# Copy this file to `.env` and fill in your real URL.
DATABASE_URL="postgresql://user:password@localhost:5432/tstack?schema=public"

# Signs session cookies and tokens. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public origin of this deployment. Better Auth builds the links in verification,
# reset and invitation emails from it — without it they point at the wrong route,
# and the app refuses to start outside development. In development set it to
# whatever the dev server prints, port included.
BETTER_AUTH_URL="http://localhost:5173"

# Transactional email. While this is empty, `src/lib/server/mail.ts` prints the
# message to the terminal instead of sending it — enough to click a verification
# link in development without a Resend account.
RESEND_API_KEY=""

# Where uploaded images are written. Keep this outside the app directory,
# otherwise a deployment wipes it. On Railway, mount a volume and point it here:
# UPLOAD_DIR="/data/uploads"
UPLOAD_DIR=".uploads"

# OAuth. Only needed for the providers switched on in
# `src/lib/server/config.json` under `auth.socialProviders`.
# Callback URLs: <origin>/api/auth/callback/google and .../callback/github
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
